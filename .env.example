# =============================================================================
# SECURITY WARNING
# =============================================================================
# This file contains placeholder values. You MUST change all passwords and
# secrets before deploying to production!
#
# Run: cp .env.example .env
# Then edit .env with secure values
#
# Use these commands to generate secure secrets:
#   openssl rand -base64 32  (for NEXTAUTH_SECRET)
#   openssl rand -hex 32    (for passwords)
# =============================================================================

# =============================================================================
# GENERAL CONFIGURATION
# =============================================================================
TZ=UTC
LETSENCRYPT_EMAIL=your-email@example.com

# =============================================================================
# FRONTEND APPLICATION CONFIGURATION
# =============================================================================
NEXTAUTH_URL=https://hyfern.us
# REQUIRED: Generate with: openssl rand -base64 32
NEXTAUTH_SECRET=change_this_to_random_32_byte_secret

# Server access password (for public landing page password gate)
# Authenticated users bypass this when accessing /connect page
# REQUIRED: Change to a strong password
SERVER_ACCESS_PASSWORD=change_this_server_password

# Public server address (shown after password verification or authentication)
NEXT_PUBLIC_SERVER_ADDRESS=hyfern.us

# Initial admin credentials (created on first database setup)
# REQUIRED: Change immediately after first login
INIT_ADMIN_USERNAME=admin
INIT_ADMIN_PASSWORD=admin123

# =============================================================================
# REDIS CONFIGURATION
# =============================================================================
# REQUIRED: Change this to a strong password (min 16 characters)
REDIS_PASSWORD=change_this_redis_password

# =============================================================================
# HYTALE SERVER CONFIGURATION (Java Container)
# =============================================================================
# JVM Memory Settings (reduced for 8GB RAM servers)
HYTALE_MEMORY=2G
HYTALE_MAX_MEMORY=3G

# Garbage Collection (G1GC or ZGC)
HYTALE_GC=G1GC
HYTALE_MAX_GC_PAUSE=200

# Custom JVM flags (optional)
HYTALE_CUSTOM_JVM_FLAGS=

# AOT Cache file
HYTALE_AOT_CACHE=HytaleServer.aot

# Server Ports
HYTALE_SERVER_PORT=5520
HYTALE_WEBSERVER_PORT=5523

# =============================================================================
# HYTALE WEBSERVER PLUGIN CONFIGURATION
# =============================================================================
# Username for the service account on WebServer plugin (default: hyfern)
HYTALE_WEBSERVER_USERNAME=hyfern

# Password for the service account on WebServer plugin
# This will be used by the WebServer plugin for API authentication
HYTALE_WEBSERVER_PASSWORD=change_this_webserver_password

# =============================================================================
# BACKUP CONFIGURATION
# =============================================================================
BACKUP_ENABLED=false
BACKUP_FREQUENCY=60
BACKUP_RETENTION=7

# =============================================================================
# MONITORING CONFIGURATION
# =============================================================================
# Prometheus username for metrics scraping (default: prometheus)
PROMETHEUS_USERNAME=prometheus

# Prometheus password for metrics scraping
# IMPORTANT: Must match the password in your Hytale WebServer plugin config
PROMETHEUS_PASSWORD=change_this_prometheus_password

# Grafana root URL
GRAFANA_ROOT_URL=https://grafana.hyfern.us

# Grafana admin password
GRAFANA_ADMIN_PASSWORD=change_this_grafana_password

# =============================================================================
# CURSEFORGE API CONFIGURATION (OPTIONAL)
# =============================================================================
# Get your API key from: https://console.curseforge.com/
# Leave empty or remove to disable CurseForge mod browsing
# IMPORTANT: If your API key contains $ characters, escape them with $$
CURSEFORGE_API_KEY=
