# =============================================================================
# GENERAL CONFIGURATION
# =============================================================================
TZ=UTC
LETSENCRYPT_EMAIL=your-email@example.com

# =============================================================================
# DOCKER CONFIGURATION
# =============================================================================
# Path to Docker container logs on the host (for Wings)
# Standard Docker:       /var/lib/docker/containers
# Docker via snap:       /var/snap/docker/common/var-lib-docker/containers
DOCKER_CONTAINERS_PATH=/var/lib/docker/containers

# =============================================================================
# DATABASE CONFIGURATION
# =============================================================================
# Frontend uses SQLite (file-based database)
# The database file is automatically created at ./data/hyfern.db

# Pelican Panel Database (SQLite)
# Uses SQLite file at /var/www/html/database/database.sqlite

# =============================================================================
# REDIS CONFIGURATION
# =============================================================================
REDIS_PASSWORD=change_this_redis_password

# =============================================================================
# PELICAN PANEL CONFIGURATION
# =============================================================================
PELICAN_APP_URL=https://panel.hyfern.us
# Generate with: php artisan key:generate --show (or use: base64:YOUR_BASE64_KEY_HERE)
PELICAN_APP_KEY=base64:CHANGE_THIS_TO_GENERATED_KEY

# =============================================================================
# PELICAN PANEL EMAIL CONFIGURATION
# =============================================================================
MAIL_DRIVER=smtp
MAIL_HOST=smtp.example.com
MAIL_PORT=587
MAIL_USERNAME=your-smtp-username
MAIL_PASSWORD=your-smtp-password
MAIL_FROM_ADDRESS=noreply@hyfern.us

# =============================================================================
# FRONTEND APPLICATION CONFIGURATION
# =============================================================================
NEXTAUTH_URL=https://hyfern.us
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET=change_this_to_random_32_byte_secret

# Server access password (for public landing page password gate)
# Authenticated users bypass this when accessing /connect page
SERVER_ACCESS_PASSWORD=change_this_server_password

# Public server address (shown after password verification or authentication)
NEXT_PUBLIC_SERVER_ADDRESS=hyfern.us

# Initial admin credentials (created on first database setup)
# These credentials work for frontend, Grafana, and all authenticated services
INIT_ADMIN_USERNAME=admin
INIT_ADMIN_PASSWORD=admin123

# =============================================================================
# WINGS API CONFIGURATION
# =============================================================================
# Generate API key from Pelican Panel admin interface
WINGS_API_KEY=change_this_to_wings_api_key
WINGS_SERVER_UUID=your-server-uuid

# =============================================================================
# PELICAN API CONFIGURATION
# =============================================================================
# Generate API key from Pelican Panel admin interface
PELICAN_API_KEY=change_this_to_pelican_api_key
PELICAN_SERVER_UUID=your-server-uuid

# =============================================================================
# HYTALE SERVER CONFIGURATION
# =============================================================================
SERVER_MEMORY=4G
GC_TYPE=G1GC
MAX_GC_PAUSE=200
PARALLEL_REF_PROC=true
AOT_CACHE=HytaleServer.aot
BACKUP_ENABLED=false
BACKUP_FREQUENCY=60
CUSTOM_JVM_FLAGS=
DISABLE_SENTRY=false

# =============================================================================
# HYTALE WEBSERVER PLUGIN CONFIGURATION
# =============================================================================
# Username for the service account on WebServer plugin (default: hyfern)
HYTALE_WEBSERVER_USERNAME=hyfern

# Password for the service account on WebServer plugin
# This will be bcrypt hashed in the provisioning config
HYTALE_WEBSERVER_PASSWORD=change_this_webserver_password

# Prometheus username for metrics scraping (default: prometheus)
PROMETHEUS_USERNAME=prometheus

# Prometheus password for metrics scraping
# This will be bcrypt hashed in the provisioning config
PROMETHEUS_PASSWORD=change_this_prometheus_password

# =============================================================================
# CURSEFORGE API CONFIGURATION (OPTIONAL)
# =============================================================================
# Get your API key from: https://console.curseforge.com/
# Leave empty or remove to disable CurseForge mod browsing (manual upload still works)
# IMPORTANT: If your API key contains $ characters, you MUST escape each one
# by doubling it. For example, if your key is:  $2a$10$PV.abc
# then write it as:                             $$2a$$10$$PV.abc
CURSEFORGE_API_KEY=
# Optional: Override the game ID (default: 70216 for Hytale)
# CURSEFORGE_GAME_ID=70216

# =============================================================================
# GRAFANA CONFIGURATION
# =============================================================================
GRAFANA_ROOT_URL=https://grafana.hyfern.us
# Note: Grafana uses proxy authentication via frontend JWT tokens
# No separate admin password needed - use INIT_ADMIN_USERNAME/PASSWORD above
