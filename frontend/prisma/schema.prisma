// Prisma schema for HyFern
// Database configuration

generator client {
  provider = "prisma-client-js"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

// User role enumeration
enum Role {
  OWNER      // Full system access
  ADMIN      // Admin privileges
  MODERATOR  // Moderate privileges
  VIEWER     // Read-only access
}

// User authentication and authorization
model User {
  id           String   @id @default(cuid())
  username     String   @unique
  passwordHash String
  role         Role     @default(VIEWER)
  avatarPath   String?

  // TOTP 2FA fields
  totpSecret   String?
  totpEnabled  Boolean  @default(false)
  recoveryCodes String  @default("[]") // JSON array stored as string

  // Timestamps
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  // Relations
  sessions     Session[]
  installedMods InstalledMod[]

  @@map("users")
}

// Session management for authenticated users
model Session {
  id           String   @id @default(cuid())
  userId       String
  expiresAt    DateTime
  lastActiveAt DateTime @default(now())
  ipAddress    String?
  userAgent    String?
  createdAt    DateTime @default(now())

  // Relations
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("sessions")
}

// Hytale mods installed on the server
model InstalledMod {
  id           String   @id @default(cuid())
  curseforgeId Int?     @unique
  name         String
  slug         String
  version      String
  fileName     String   @unique
  installedAt  DateTime @default(now())
  installedBy  String
  isCore       Boolean  @default(false) // Core mods cannot be uninstalled

  // Relations
  installer    User     @relation(fields: [installedBy], references: [id])

  @@index([slug])
  @@index([installedAt])
  @@map("installed_mods")
}

// Security: Track login attempts for rate limiting
model LoginAttempt {
  id        String   @id @default(cuid())
  ipAddress String
  success   Boolean
  createdAt DateTime @default(now())

  @@index([ipAddress, createdAt])
  @@index([createdAt])
  @@map("login_attempts")
}

// JVM Configuration for Hytale server
model ServerConfig {
  id            Int     @id @default(1)
  minMemory     Int     @default(4096)  // MB
  maxMemory     Int     @default(6144)
  gcType        String  @default("G1GC")  // G1GC or ZGC
  maxGCPause    Int     @default(200)
  customFlags   String?
  aotCache      String  @default("HytaleServer.aot")
  updatedAt     DateTime @updatedAt

  @@map("server_config")
}

// Hytale server configuration (config.json)
model HytaleConfig {
  id            Int     @id @default(1)
  serverName    String  @default("HyFern Server")
  motd          String  @default("Welcome to HyFern!")
  maxPlayers    Int     @default(100)
  maxViewRadius Int     @default(32)
  viewDistance  Int     @default(16)
  password      String?
  updatedAt     DateTime @updatedAt

  @@map("hytale_config")
}

// Backup records
model Backup {
  id        Int      @id @default(autoincrement())
  filename  String
  size      Int      // bytes
  createdAt DateTime @default(now())
  path      String

  @@map("backups")
}
