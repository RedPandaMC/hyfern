{
    email {$LETSENCRYPT_EMAIL}
}

# Main frontend application
hyfern.us {
    reverse_proxy hyfern-frontend:3000

    encode gzip

    header {
        Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
        X-Frame-Options "SAMEORIGIN"
        X-Content-Type-Options "nosniff"
        X-XSS-Protection "1; mode=block"
        Referrer-Policy "strict-origin-when-cross-origin"
        Access-Control-Allow-Origin "https://hyfern.us"
        Access-Control-Allow-Methods "GET, POST, PUT, DELETE, OPTIONS"
        Access-Control-Allow-Headers "Content-Type, Authorization, X-Auth-User, X-Auth-Role"
        Access-Control-Max-Age "3600"
        -Server
    }

    @cors_preflight method OPTIONS
    header @cors_preflight {
        Access-Control-Allow-Origin "https://hyfern.us"
        Access-Control-Allow-Methods "GET, POST, PUT, DELETE, OPTIONS"
        Access-Control-Allow-Headers "Content-Type, Authorization, X-Auth-User, X-Auth-Role"
        Access-Control-Max-Age "3600"
    }
    respond @cors_preflight 204

    log {
        output file /data/logs/hyfern.log
        format json
    }
}

# Redirect www to non-www
www.hyfern.us {
    redir https://hyfern.us{uri}
}

# Grafana dashboards (auth via frontend JWT)
grafana.hyfern.us {
    @websocket {
        path /api/live/ws
        header Connection *Upgrade*
        header Upgrade    websocket
    }
    reverse_proxy @websocket grafana:3001

    @grafanaStatic {
        path /public/* /avatar/* /api/health /metrics
    }
    reverse_proxy @grafanaStatic grafana:3001

    forward_auth hyfern-frontend:3000 {
        uri /api/auth/verify
        copy_headers X-Auth-User X-Auth-Role

        @unauthorized status 401
        handle_response @unauthorized {
            redir https://hyfern.us/login?callbackUrl=https://grafana.hyfern.us{uri} 302
        }
    }

    reverse_proxy grafana:3001

    encode gzip

    header {
        Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
        Content-Security-Policy "frame-ancestors 'self' https://hyfern.us"
        X-Content-Type-Options "nosniff"
        X-XSS-Protection "1; mode=block"
        Referrer-Policy "strict-origin-when-cross-origin"
        -Server
    }

    log {
        output file /data/logs/grafana.log
        format json
    }
}
